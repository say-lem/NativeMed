    "reconcile:stripe": "ts-node src/scripts/reconcile-stripe.ts",
    "test:stripe": "ts-node -r dotenv/config src/scripts/test-stripe-connection.ts",
    "test:drive": "ts-node -r dotenv/config src/scripts/test-google-drive-connection.ts",
    "test:email": "ts-node -r dotenv/config src/scripts/test-email-connection.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
