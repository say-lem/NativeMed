{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "typeRoots": ["./node_modules/@types"],
    // Test-file type resolution (describe/it/expect) is handled by
    // tsconfig.jest.json, which extends this file and adds "jest" itself.
    // Keeping it out of this list means `npm run build` doesn't require
    // @types/jest — a devDependency — to be installed in production.
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}