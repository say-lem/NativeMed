# App
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database (required)
MONGO_URI=mongodb://127.0.0.1:27017/nativemed

# JWT (required)
ACCESS_TOKEN_SECRET=replace_with_at_least_32_characters
REFRESH_TOKEN_SECRET=replace_with_at_least_32_characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cloudinary (required)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email — sent via the Gmail API's HTTPS endpoint, not SMTP (optional in
# development; required in production if sending emails). Create an OAuth2
# Client ID in Google Cloud Console, enable the Gmail API, and generate a
# refresh token (scope: gmail.send) while logged into the Gmail/Workspace
# account matching EMAIL_FROM_ADDRESS. See src/config/gmail.ts for details.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
EMAIL_FROM_NAME=Native Med
EMAIL_FROM_ADDRESS=noreply@nativemed.com

# Contact form (optional; falls back to EMAIL_FROM_ADDRESS if unset)
CONTACT_EMAIL_TO=info@nativemeded.co.uk

# Password reset
RESET_TOKEN_EXPIRES_MINUTES=15

# Google Drive (optional) — leave unset to disable Drive integration
# From the service account JSON: client_email and private_key (use \n for newlines in the key)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Stripe (required for payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create recurring prices in GBP in your Stripe Dashboard
# Case bank: £24.99/month
STRIPE_PRICE_CASE_BANK_MONTHLY=price_...
# Course subscriptions bill each course's `price` field (GBP) via Stripe Checkout — no fixed Price IDs needed.

